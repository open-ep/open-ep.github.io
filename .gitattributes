# Normalize all text files to LF in the repo and on checkout (any OS)
* text=auto eol=lf

# Treat binary assets as binary so they're never line-ending-converted
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.pdf  binary

# Binary STL. Without this these fall under "* text=auto" and survive only
# because Git's heuristic happens to find a NUL byte in the header — don't
# leave 3D geometry riding on a guess.
*.stl  binary

# Gerber and Excellon drill are ASCII, so LF is correct for them.
*.gbr    text eol=lf
*.drl    text eol=lf
*.gbrjob text eol=lf
